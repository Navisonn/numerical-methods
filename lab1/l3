
def readi(filename="lab3.txt"):
    with open(filename) as f:
        n = int(f.readline())
        
        a = []
        for i in range(n):
            row = list(map(float, f.readline().split()))
            a.append(row)
        
        b = list(map(float, f.readline().split()))
        eps = float(f.readline())
        lenofmatrix = len(a)
    
    return lenofmatrix, a, b, eps

def simpleit (n, a , b, eps):
    max_iter = 10000
    x = [0.0] * n
    x_simple = [0.0] * n
    for k in range(1, max_iter + 1):
        for i in range(n):
            s = 0.0
            for j in range(n):
                if i != j:
                    s = s + (a[i][j] * x[j])
            x_simple[i] = (b[i] - s) / a[i][i]
        t = max(abs(x_simple[i] - x[i]) for i in range(n))
        if t < eps:
            return x_simple, k
        for i in range(n):
            x[i] = x_simple[i]
    return x, max_iter

def seidel (n, a, b, eps, max_iter=10000):
    x = [0.0] * n
    x_copy = [0.0] * n
    for k in range (1, max_iter + 1):
        for i in range (n):
            x_copy[i] = x[i]
        for i in range (n):
            s = 0.0
            for j in range(n):
                if i != j:
                    s = s + a[i][j] * x[j]
            x[i] = (b[i] - s) / a[i][i]
        t = max(abs(x_copy[i] - x[i]) for i in range(n))
        if t < eps:
            return x, k
    return x, max_iter
        
                    
def main():
    n, a, b, eps = readi("lab3.txt")
    xsimple, simpleiter = simpleit(n, a, b, eps)
    xsei, itersei = seidel(n, a, b, eps, 10000)

    print(f"N = {n}")
    print("A =")
    for row in a:
        print("   ", row)
    print("b =", b)
    print(f"eps = {eps}")

    print("x =", [round(v, 6) for v in xsimple])
    print(f"Итераций: {simpleiter}")

    print("x =", [round(v, 6) for v in xsei])
    print(f"Итераций: {itersei}")

if __name__ == "__main__":
    main()
